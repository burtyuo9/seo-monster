# SEO Monster - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Server Configuration
# ===========================================
BACKEND_PORT=8000
FRONTEND_PORT=80

# ===========================================
# AI Configuration (Required for AI features)
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===========================================
# AWS Configuration (Optional - for Email SES)
# ===========================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# ===========================================
# Telegram Notifications (Optional)
# ===========================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ===========================================
# Database Configuration (Optional)
# ===========================================
# SQLite (default):
DATABASE_URL=sqlite:///./data/seo_monster.db

# PostgreSQL (for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/seomonster
# POSTGRES_USER=seomonster
# POSTGRES_PASSWORD=seomonster_secret
# POSTGRES_DB=seomonster
# POSTGRES_PORT=5432

# ===========================================
# Redis Configuration (Optional)
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ===========================================
# Security (Change in production!)
# ===========================================
SECRET_KEY=change-this-to-a-random-string-in-production
